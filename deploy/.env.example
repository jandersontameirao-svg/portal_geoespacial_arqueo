# ===================================================================
# Portal Geoespacial Arqueo — variáveis de ambiente (produção)
# ===================================================================
# Copie este arquivo para  /var/www/geoportal/.env  e preencha os valores.
# NUNCA faça commit do .env — ele já está no .gitignore.
# Dica: edite com `nano .env` para que o shell não expanda `$` nas senhas.

# Ambiente (não altere em produção)
NODE_ENV=production

# Porta local onde o Node escuta (apenas no loopback; só o nginx acessa).
# Confirme que está livre:  ss -tlnp | grep ':8002' || echo LIVRE
PORT=8002
HOST=127.0.0.1

# Banco MySQL local. Formato: mysql://USUARIO:SENHA@127.0.0.1:3306/BANCO
# Se a senha tiver caracteres especiais (@ : / #), faça URL-encode.
DATABASE_URL=mysql://geoportal:TROQUE_ESTA_SENHA@127.0.0.1:3306/portal_geo

# Segredo que assina os cookies de sessão (JWT HS256). OBRIGATÓRIO e forte.
# Gere na VPS com:  openssl rand -hex 32
JWT_SECRET=

# Identificador estável do app. Entra tanto no build do client quanto na
# verificação do JWT no servidor — precisa ser IGUAL em build e runtime, e
# estar definido ANTES de rodar `pnpm build`. Pode ser um texto fixo:
VITE_APP_ID=geoportal-arqueo

# -------------------------------------------------------------------
# IA (Assistente Atena e "Organizar com Atena" das Observações).
# OPCIONAL: sem chave, os recursos de IA ficam desativados com aviso
# ("provedor não configurado"); o CRUD de Observações funciona normalmente.
# -------------------------------------------------------------------
# Chave do provedor (OpenAI por padrão). Sem ela, a IA fica desligada.
OPENAI_API_KEY=
# Endpoint compatível com a API OpenAI. Deixe vazio para usar a OpenAI oficial
# (https://api.openai.com). Informe só o host, sem /v1.
OPENAI_BASE_URL=
# Modelo a usar. Vazio = gpt-4o-mini (OpenAI). Ex.: gpt-4o, gpt-4.1-mini.
LLM_MODEL=
