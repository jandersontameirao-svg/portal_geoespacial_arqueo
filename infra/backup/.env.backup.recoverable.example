# Backup recuperável on-premise — NÃO usar este template no ambiente de ensaio isolado.
# Requer permissões restritas do serviço, volumes persistentes e ensaio de restauração.

# Seleção explícita do adaptador.
ARQUEO_BACKUP_STORE=filesystem

# Raiz de leitura dos blobs ativos, com as chaves lógicas usadas em files.s3Key,
# file_versions.s3Key, base_layers.s3Key, gis_uploads.s3Key, print_jobs.outputS3Key e atlas_jobs.
ARQUEO_BACKUP_SOURCE_FILESYSTEM_ROOT=/var/lib/arqueo/storage

# Raiz separada e persistente para artifact.json, manifest.json, checksums e blobs copiados.
ARQUEO_BACKUP_FILESYSTEM_ROOT=/var/lib/arqueo/backups

# Não definir ARQUEO_EXECUTION_MODE=isolated-rehearsal em host que deva executar backup.
# O processo do serviço precisa ter read-only na origem e read/write somente no destino.
# Antes de habilitar agendamento, execute restauração em banco/volume descartáveis.
