[32m+[m
[32m+[m[32mdef sha256(path: Path) -> str:[m
[32m+[m[32m    digest = hashlib.sha256()[m
[32m+[m[32m    with path.open("rb") as stream:[m
[32m+[m[32m        for chunk in iter(lambda: stream.read(1024 * 1024), b""):[m
[32m+[m[32m            digest.update(chunk)[m
[32m+[m[32m    return digest.hexdigest()[m
