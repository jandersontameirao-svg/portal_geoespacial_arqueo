[32m+[m[32m#!/usr/bin/env python3[m
[32m+[m[32m"""Prepara tiles XYZ PNG locais a partir de um COG já aprovado.[m
[32m+[m
[32m+[m[32mExecuta somente sobre paths locais fornecidos pelo processo servidor. Não faz rede,[m
[32m+[m[32mnão recebe URL, não serve arquivos e não acessa banco/storage remoto.[m
[32m+[m[32m"""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport argparse[m
