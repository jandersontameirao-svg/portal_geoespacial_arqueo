[32m+[m[32m# file_versions.s3Key, base_layers.s3Key, gis_uploads.s3Key, print_jobs.outputS3Key e atlas_jobs.[m
[32m+[m[32mARQUEO_BACKUP_SOURCE_FILESYSTEM_ROOT=/var/lib/arqueo/storage[m
[32m+[m
[32m+[m[32m# Raiz separada e persistente para artifact.json, manifest.json, checksums e blobs copiados.[m
[32m+[m[32mARQUEO_BACKUP_FILESYSTEM_ROOT=/var/lib/arqueo/backups[m
[32m+[m
[32m+[m[32m# Não definir ARQUEO_EXECUTION_MODE=isolated-rehearsal em host que deva executar backup.[m
[32m+[m[32m# O processo do serviço precisa ter read-only na origem e read/write somente no destino.[m
