[32m+[m[32mconst BACKOFF_BASE_MS = 60_000;[m
[32m+[m[32mconst BACKOFF_CAP_MS = 6 * 60 * 60 * 1000;[m
[32m+[m
[32m+[m[32mfunction asDate(value: Date | string | null | undefined) {[m
[32m+[m[32m  if (!value) return null;[m
[32m+[m[32m  const date = new Date(value);[m
[32m+[m[32m  return Number.isNaN(date.getTime()) ? null : date;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mexport function computeRetryAfter(failureCount: number, now = new Date()) {[m
[32m+[m[32m  const safeFailureCount = Math.max(1, Math.min(16, Math.floor(failureCount)));[m
[32m+[m[32m  const delay = Math.min(BACKOFF_CAP_MS, BACKOFF_BASE_MS * 2 ** (safeFailureCount - 1));[m
[32m+[m[32m  return new Date(now.getTime() + delay);[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mexport function isBackoffActive(record: BaseLayerCacheRecord, now = new Date()) {[m
[32m+[m[32m  const retryAfter = asDate(record.retryAfter);[m
[32m+[m[32m  return Boolean(retryAfter && retryAfter.getTime() > now.getTime());[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mexport function classifyBaseLayerCache(record: BaseLayerCacheRecord, now = new Date()): BaseLayerCacheState {[m
[32m+[m[32m  if (record.downloadStatus === "downloading") return "refreshing";[m
[32m+[m[32m  if (record.downloadStatus === "failed" && isBackoffActive(record, now)) return "backoff";[m
[32m+[m[32m  if (record.downloadStatus === "failed") return record.dataUrl ? "stale" : "failed";[m
[32m+[m[32m  if (!record.dataUrl) return "missing";[m
[32m+[m[32m  const expiresAt = asDate(record.cacheExpiresAt);[m
[32m+[m[32m  return expiresAt && expiresAt.getTime() > now.getTime() ? "fresh" : "stale";[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mexport function canRefreshBaseLayer(record: BaseLayerCacheRecord | undefined, forceUpdate: boolean, now = new Date()) {[m
[32m+[m[32m  if (!record) return { allowed: true as const, reason: null };[m
[32m+[m[32m  if (forceUpdate) return { allowed: true as const, reason: null };[m
[32m+[m[32m  if (isBackoffActive(record, now)) {[m
[32m+[m[32m    const retryAfter = asDate(record.retryAfter)!;[m
[32m+[m[32m    return { allowed: false as const, reason: `Atualização adiada por backoff até ${retryAfter.toISOString()}`, retryAfter };[m
[32m+[m[32m  }[m
[32m+[m[32m  return { allowed: true as const, reason: null };[m
[32m+[m[32m}[m
