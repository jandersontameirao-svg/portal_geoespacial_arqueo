[32m+[m
[32m+[m[32mconst SYSTEM = [[m
[32m+[m[32m  "Você converte pedidos de análise GIS em português em um JSON estruturado.",[m
[32m+[m[32m  "Responda somente com JSON no formato: {\"operation\",\"referenceLayerId\",\"sourceLayerIds\",\"distanceM\",\"outputName\",\"explanation\"}.",[m
