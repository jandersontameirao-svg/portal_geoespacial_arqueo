[32m+[m
[32m+[m[32mexport type Municipality = { code: string; name: string; feat: Feat };[m
[32m+[m[32mexport type MunicipalitySelection = { code: string; name: string; status: "selecionado" | "revisar_toque"; overlapAreaM2: number };[m
[32m+[m
[32m+[m[32m/**[m
