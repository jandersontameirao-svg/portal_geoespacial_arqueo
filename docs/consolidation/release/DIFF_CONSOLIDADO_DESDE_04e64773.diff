[32m+[m
[32m+[m[32mdef epsg(dataset: gdal.Dataset) -> int | None:[m
[32m+[m[32m    srs = osr.SpatialReference()[m
[32m+[m[32m    srs.ImportFromWkt(dataset.GetProjection())[m
[32m+[m[32m    srs.AutoIdentifyEPSG()[m
[32m+[m[32m    code = srs.GetAuthorityCode(None)[m
[32m+[m[32m    return int(code) if code else None[m
[32m+[m
[32m+[m
[32m+[m[32mdef main() -> None:[m
[32m+[m[32m    parser = argparse.ArgumentParser()[m
[32m+[m[32m    parser.add_argument("--input", required=True, type=Path)[m
[32m+[m[32m    parser.add_argument("--tiles", required=True, type=Path)[m
[32m+[m[32m    parser.add_argument("--min-zoom", required=True, type=int)[m
[32m+[m[32m    parser.add_argument("--max-zoom", required=True, type=int)[m
[32m+[m[32m    parser.add_argument("--expected-crs", default="EPSG:4674")[m
[32m+[m[32m    parser.add_argument("--require-nodata", action="store_true")[m
[32m+[m[32m    parser.add_argument("--manifest", required=True, type=Path)[m
[32m+[m[32m    args = parser.parse_args()[m
[32m+[m[32m    if not args.input.is_file(): raise SystemExit("COG de entrada não encontrado")[m
[32m+[m[32m    if not 0 <= args.min_zoom <= args.max_zoom <= 22: raise SystemExit("Faixa de zoom inválida")[m
[32m+[m[32m    ds = gdal.Open(str(args.input), gdal.GA_ReadOnly)[m
[32m+[m[32m    if ds is None: raise SystemExit("GDAL não abriu o COG")[m
[32m+[m[32m    layout = (ds.GetMetadata("IMAGE_STRUCTURE") or {}).get("LAYOUT")[m
[32m+[m[32m    expected_epsg = int(args.expected_crs.split(":", 1)[1])[m
[32m+[m[32m    source_epsg = epsg(ds)[m
[32m+[m[32m    nodata = [ds.GetRasterBand(i).GetNoDataValue() for i in range(1, ds.RasterCount + 1)][m
[32m+[m[32m    if layout != "COG": raise SystemExit("A fonte deve ser Cloud Optimized GeoTIFF")[m
[32m+[m[32m    if source_epsg != expected_epsg: raise SystemExit(f"CRS inesperado: EPSG:{source_epsg}; esperado {args.expected_crs}")[m
[32m+[m[32m    if args.require_nodata and any(value is None for value in nodata): raise SystemExit("Todas as bandas precisam declarar NoData")[m
[32m+[m[32m    if min(ds.GetRasterBand(i).GetOverviewCount() for i in range(1, ds.RasterCount + 1)) < 1: raise SystemExit("COG sem pirâmide interna")[m
[32m+[m[32m    ds = None[m
[32m+[m[32m    if args.tiles.exists(): shutil.rmtree(args.tiles)[m
[32m+[m[32m    args.tiles.parent.mkdir(parents=True, exist_ok=True)[m
[32m+[m[32m    command = [[m
[32m+[m[32m        "/usr/bin/gdal2tiles.py", "--xyz", "--profile=mercator", "--resampling=cubic",[m
[32m+[m[32m        "--tilesize=256", f"--zoom={args.min_zoom}-{args.max_zoom}",[m
[32m+[m[32m        str(args.input), str(args.tiles),[m
[32m+[m[32m    ][m
[32m+[m[32m    subprocess.run(command, check=True, text=True)[m
[32m+[m[32m    tiles = sorted(args.tiles.glob("*/*/*.png"))[m
[32m+[m[32m    if not tiles: raise SystemExit("gdal2tiles não produziu PNGs")[m
[32m+[m[32m    manifest = {[m
[32m+[m[32m        "kind": "local-raster-xyz",[m
[32m+[m[32m        "source": {"filename": args.input.name, "sha256": sha256(args.input), "crs": args.expected_crs, "nodata": nodata},[m
[32m+[m[32m        "tiles": {"scheme": "xyz", "crs": "EPSG:3857", "tileSize": 256, "minZoom": args.min_zoom, "maxZoom": args.max_zoom, "count": len(tiles)},[m
[32m+[m[32m    }[m
[32m+[m[32m    args.manifest.parent.mkdir(parents=True, exist_ok=True)[m
[32m+[m[32m    args.manifest.write_text(json.dumps(manifest, ensure_ascii=False, indent=2) + "\n")[m
[32m+[m[32m    print(json.dumps(manifest, ensure_ascii=False))[m
[32m+[m
[32m+[m
[32m+[m[32mif __name__ == "__main__":[m
[32m+[m[32m    main()[m
