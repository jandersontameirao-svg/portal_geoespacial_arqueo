[32m+[m[32m  else if (geom.type === "Polygon") geom.coordinates.forEach((r: number[][]) => out.push(...r));[m
[32m+[m[32m  else if (geom.type === "MultiPolygon") geom.coordinates.forEach((p: number[][][]) => p.forEach(r => out.push(...r)));[m
