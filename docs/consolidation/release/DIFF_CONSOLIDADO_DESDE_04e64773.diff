[32m+[m[32mexport type BaseLayerCacheRecord = {[m
[32m+[m[32m  dataUrl?: string | null;[m
[32m+[m[32m  cacheExpiresAt?: Date | string | null;[m
[32m+[m[32m  downloadStatus: "pending" | "downloading" | "completed" | "failed";[m
[32m+[m[32m  refreshFailureCount?: number | null;[m
[32m+[m[32m  retryAfter?: Date | string | null;[m
[32m+[m[32m  lastRefreshAttemptAt?: Date | string | null;[m
[32m+[m[32m  errorMessage?: string | null;[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mexport type BaseLayerCacheState = "missing" | "fresh" | "stale" | "refreshing" | "backoff" | "failed";[m
