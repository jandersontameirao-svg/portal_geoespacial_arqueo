# ===================================
# GIS Infrastructure Environment Variables
# ===================================
# Copy this file to .env.gis and fill in the values

# PostGIS Database
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=arqueo_gis
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_me_in_production

# QGIS Server
QGIS_SERVER_HOST=qgis-server
QGIS_SERVER_PORT=8080
QGIS_PROJECT_FILE=/etc/qgis/projects/demo_project.qgz

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Worker
WORKER_CONCURRENCY=2
WORKER_LOG_LEVEL=info
# Limite de GeoTIFF aceito pelo worker (bytes)
RASTER_MAX_INPUT_BYTES=104857600
# Defina um segredo forte somente em servidor/desktop controlado; não comite .env.gis.
RASTER_WORKER_TOKEN=change_me_worker_token

# Portal Integration
PORTAL_URL=http://localhost:3000
WMS_PUBLIC_URL=http://localhost:8080/ows
# Opcional: o Portal chama o worker apenas pela rede interna/host confiável.
ARQUEO_RASTER_WORKER_URL=http://localhost:3001
ARQUEO_RASTER_WORKER_TOKEN=change_me_worker_token

# Renderização cartográfica/Atlas (PDF real a partir de COG processado no volume GIS)
ARQUEO_CARTOGRAPHY_WORKER_URL=http://localhost:3001
ARQUEO_CARTOGRAPHY_WORKER_TOKEN=change_me_cartography_token
CARTOGRAPHY_WORKER_TOKEN=change_me_cartography_token
ATLAS_MAX_PAGES=50
ATLAS_MAX_OUTPUT_BYTES=83886080
# Orçamento de memória/resolução por folha: A4 1.800x1.200, A3 2.400x1.600,
# A1 4.200x2.800 e A0 5.600x3.800. O worker bloqueia perfis acima destes limites.
ATLAS_MAX_RENDER_PIXELS=24000000
ATLAS_MAX_OVERLAY_BYTES=5242880
