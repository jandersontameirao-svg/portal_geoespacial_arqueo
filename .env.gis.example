# ===================================
# GIS Infrastructure Environment Variables
# ===================================
# Copy this file to .env.gis and fill in the values

# PostGIS Database
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=arqueo_gis
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_me_in_production

# QGIS Server
QGIS_SERVER_HOST=qgis-server
QGIS_SERVER_PORT=8080
QGIS_PROJECT_FILE=/etc/qgis/projects/demo_project.qgz

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Worker
WORKER_CONCURRENCY=2
WORKER_LOG_LEVEL=info

# Portal Integration
PORTAL_URL=http://localhost:3000
WMS_PUBLIC_URL=http://localhost:8080/ows
